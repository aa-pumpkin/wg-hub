# Docker Compose reads this file. Everything is optional for a local trial;
# set a real POSTGRES_PASSWORD before putting the app on a server.

# Port the app is served on (http://localhost:8080)
APP_PORT=8080

# Database password (the database is never published outside Docker)
POSTGRES_PASSWORD=change-me

# Only needed if a proxy rewrites the Host header: the public URL of the app.
# APP_ORIGIN=https://wg.example.com

# Max login/register attempts per IP per minute
# RATE_LIMIT_AUTH_MAX=20
